{
  "name": "rankedapp",
  "compatibility_date": "2026-11-12",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls wake the Worker; the app itself is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  // Workers AI powers the "Ask Ranked" bar and the Memory Mode AI search.
  "ai": { "binding": "AI" },
  // Required by Cloudflare's branch preview builds (`wrangler preview`); can stay empty.
  "previews": {}
}
